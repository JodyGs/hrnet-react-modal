{
  "name": "@jodygs/hrnet-react-modal",
  "version": "1.0.0",
  "description": "Accessible, lightweight React modal component converted from the jQuery plugin jquery-modal for the HRnet application.",
  "keywords": [
    "react",
    "modal",
    "dialog",
    "component",
    "accessible",
    "jquery-modal",
    "hrnet"
  ],
  "author": "Jody Gonzales",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JodyGs/hrnet-react-modal.git"
  },
  "homepage": "https://github.com/JodyGs/hrnet-react-modal#readme",
  "bugs": {
    "url": "https://github.com/JodyGs/hrnet-react-modal/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.types.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
